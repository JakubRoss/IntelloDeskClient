<UserControl x:Class="IntelloDeskClient.Views.NowePrzyjecieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IntelloDeskClient.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Width="350">
        <TextBlock Text="Nowe przyjęcie dokumentu" FontSize="20" FontWeight="Bold" Margin="0 0 0 20"/>
        <TextBlock Text="Kontrahent" />
        <ComboBox ItemsSource="{Binding Kontrahenci}"
                  SelectedItem="{Binding WybranyKontrahent}"
                  DisplayMemberPath="Nazwa"
                  Margin="0 5 0 15"/>

        <TextBlock Text="Towar" />
        <ComboBox ItemsSource="{Binding Towary}"
                  SelectedItem="{Binding WybranyTowar}"
                  Margin="0 5 0 15">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Id}" />
                        <Run Text="|" />
                        <Run Text="{Binding NazwaTowaru}" />
                        <Run Text=" (" />
                        <Run Text="{Binding JednostkaMiary}" />
                        <Run Text=")" />
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Symbol/Nazwa" />
        <TextBox Text="{Binding Symbol}" Margin="0 5 0 20" />
        <TextBlock Text="Ilość" />
        <TextBox Text="{Binding Ilosc}" Margin="0 5 0 20" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button Content="Zapisz" Command="{Binding ZapiszCommand}" Width="80"/>
            <Button Content="Anuluj" Command="{Binding AnulujCommand}" Width="80"/>
        </StackPanel>
    </StackPanel>
</UserControl>
