<UserControl x:Class="IntelloDeskClient.Views.PozycjaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="20">
        <StackPanel>

            <!-- Tytuł -->
            <TextBlock Text="Pozycje dokumentu"
                       FontSize="20" FontWeight="Bold"
                       Margin="0 0 0 10"/>

            <!-- Panel dodawania towaru -->
            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Wybierz towar" Margin="0,0,0,2"/>
                    <ComboBox Width="250"
                              ItemsSource="{Binding Towary}"
                              SelectedItem="{Binding WybranyTowar}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                    <Run Text="{Binding NazwaTowaru}" />
                                    <Run Text=" (" />
                                    <Run Text="{Binding JednostkaMiary}" />
                                    <Run Text=")" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Ilość" Margin="0,0,0,2"/>
                    <TextBox Width="80" Height="22"
                             Text="{Binding NowaIlosc}" />
                </StackPanel>

                <Button Content="Dodaj Towar +"
                        Background="#97D97E"
                        Command="{Binding DodajTowarCommand}"
                Padding="10 2.5"
                        VerticalAlignment="Bottom" />
            </StackPanel>

            <!-- Tabela pozycji -->
            <DataGrid ItemsSource="{Binding Pozycje}"
                      SelectedItem="{Binding WybranaPozycja}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      AlternatingRowBackground="#F5F5F5"
                      Padding="5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50" />
                    <DataGridTextColumn Header="Nazwa towaru" Binding="{Binding NazwaTowaru}" Width="*" />
                    <DataGridTextColumn Header="Jednostka" Binding="{Binding JednostkaMiary}" Width="150" />
                    <DataGridTextColumn Header="Ilość" Binding="{Binding Ilosc}" Width="100" />
                    <DataGridTemplateColumn Width="100" Header="Akcje">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Usuń pozycje" Background="#EC9C9D"
                                Command="{Binding DataContext.UsunPozycjeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>

        <!-- Powrót -->
        <Button Content="← Powrót"
                Command="{Binding PowrotCommand}"
                Margin="20"
                Padding="10 5"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
