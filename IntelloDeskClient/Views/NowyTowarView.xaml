<UserControl x:Class="IntelloDeskClient.Views.NowyTowarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IntelloDeskClient.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="40">
        <StackPanel Width="400">
            <TextBlock Text="Nowy towar" FontSize="20" FontWeight="Bold" Margin="0 0 0 20"/>

            <TextBlock Text="Nazwa" />
            <TextBox Text="{Binding Nazwa, UpdateSourceTrigger=PropertyChanged}" Margin="0 5 0 10" />

            <TextBlock Text="Jednostka miary" />
            <TextBox Text="{Binding JednostkaMiary, UpdateSourceTrigger=PropertyChanged}" Margin="0 5 0 20" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Zapisz" Command="{Binding ZapiszCommand}" Width="80"/>
                <Button Content="Anuluj" Command="{Binding AnulujCommand}" Width="80"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
